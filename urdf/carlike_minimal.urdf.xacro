<?xml version="1.0"?>
<robot name="myfirst" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1 1 1"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>
  <link name="top_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.5 0.5 0.5"/>
    </geometry>
    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
</link>

<joint name="base_to_top" type="revolute">
  <parent link="base_link"/>
  <child link="top_link"/>
  <origin xyz="0 0 0.75" rpy="0 0 0"/>
  <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  <axis xyz="0 0 1"/>
</joint>
</robot>
