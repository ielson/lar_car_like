      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/front_right_steer_link.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
    <!--   <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.033318 0.033356 0.003"/> -->
    <!--   </geometry> -->
    <!-- </collision> -->
