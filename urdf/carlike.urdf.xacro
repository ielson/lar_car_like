  </link>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/rear_right_wheel.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
    <!--   <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="31.500004 63 63"/> -->
    <!--   </geometry> -->
