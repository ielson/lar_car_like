    <!-- </inertial> -->
  </link>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/rear_left_wheel.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
