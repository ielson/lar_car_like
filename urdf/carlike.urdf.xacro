  <xacro:arg name="pkg" default="lar_car_like2"/>
  <xacro:property name="mesh_dir" value="package://$(arg pkg)/urdf/meshes"/>



  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/base_link.dae"/>
      </geometry>
    </visual>
    <!-- <collision> -->
    <!--   <origin xyz="0 0 0" rpy="0 0 0"/> -->
    <!--   <geometry> -->
    <!--     <box size="0.175621 0.225891 0.108579"/> -->
